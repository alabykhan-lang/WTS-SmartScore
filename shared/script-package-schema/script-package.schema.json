{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WTS SmartScore Script Package",
  "type": "object",
  "required": ["schema_version", "script_id", "pages", "completion_state"],
  "properties": {
    "schema_version": { "type": "string" },
    "script_id": { "type": "string" },
    "student_identity": { "type": ["object", "null"] },
    "identity_evidence": { "type": "object" },
    "subject": { "type": ["string", "null"] },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page_number", "image", "ocr_text"],
        "properties": {
          "page_id": { "type": "string" },
          "page_number": { "type": "integer", "minimum": 1 },
          "image": { "type": "string" },
          "ocr_text": { "type": "string" },
          "captured_at": { "type": "string" },
          "classification": { "enum": ["SCRIPT_COVER", "SCRIPT_CONTINUATION", "UNCERTAIN"] },
          "cover_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "boundary_reason": { "type": ["string", "null"] }
        }
      }
    },
    "completion_state": { "enum": ["IN_PROGRESS", "COMPLETE", "REVIEW_REQUIRED"] },
    "boundary_review_required": { "type": "boolean" },
    "question_paper_reference": { "type": ["string", "null"] },
    "marking_scheme_reference": { "type": ["string", "null"] }
  }
}
